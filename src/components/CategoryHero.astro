---
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  class?: string;
}

const { title, description, eyebrow, class: className } = Astro.props;
---

<section class:list={["category-hero", className]}>
  {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  <p class="hero-description">{description}</p>
</section>

<style>
  .category-hero {
    padding: 3rem 2rem;
    background: linear-gradient(135deg, #102a43, #0f7c80);
    color: #f8fbff;
    border-radius: 12px;
    margin-bottom: 2rem;
    text-align: center;
  }

  .hero-eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    margin-bottom: 0.5rem;
    color: #f4c95d;
    font-weight: 700;
  }

  h1 {
    margin: 0;
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .hero-description {
    margin-top: 1rem;
    font-size: 1.1rem;
    opacity: 0.9;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .category-hero {
      padding: 2rem 1rem;
    }
    h1 {
      font-size: 1.8rem;
    }
    .hero-description {
      font-size: 1rem;
    }
  }
</style>
