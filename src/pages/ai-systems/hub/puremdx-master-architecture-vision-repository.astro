---
import Layout from '../../../layouts/Layout.astro';
import RichContentShell from '../../../components/RichContentShell.astro';
---

<Layout title="PureMDX — Master Architecture & Vision Repository">
  <RichContentShell title="PureMDX — Master Architecture & Vision Repository" description="A comprehensive blueprint of the PureMDX medical knowledge ecosystem, covering its architecture, AI-assisted ingestion pipeline, and future roadmap.">
    <div class="puremdx-content">
      <section class="hero">
        <div class="hero-grid">
          <div>
            <div class="brand">
              <img src="/assets/images/brand/puremdx-logo.png" alt="PureMDX Logo">
              <div>
                <div style="font-size:0.95rem;color:rgba(248,250,252,0.7)">Dr. Sandeep Shrivastva</div>
                <div style="font-size:2rem;font-weight:800">PureMDX</div>
              </div>
            </div>

            <h1>
              Building A <span class="accent">Premium</span><br>
              Medical Knowledge Ecosystem
            </h1>

            <p>
              I designed PureMDX as a deterministic, scalable, AI-assisted medical knowledge architecture that combines Ayurveda, clinical medicine, diagnostics, research systems, semantic intelligence, multilingual publishing, static infrastructure, and enterprise-grade content automation into a single production-ready ecosystem.
            </p>

            <div class="hero-tags">
              <div class="tag">Firebase Hosting</div>
              <div class="tag">Static Deterministic Architecture</div>
              <div class="tag">AI-Assisted Ingestion</div>
              <div class="tag">Semantic Graph Intelligence</div>
              <div class="tag">Medical Knowledge Mapping</div>
              <div class="tag">PWA + Offline Ready</div>
            </div>
          </div>

          <div class="hero-card">
            <h3>Current System Status</h3>

            <div class="metric">
              <span>Deployment Pipeline</span>
              <strong>ACTIVE</strong>
            </div>

            <div class="metric">
              <span>Validation Status</span>
              <strong>PASS</strong>
            </div>

            <div class="metric">
              <span>Broken Links</span>
              <strong>0</strong>
            </div>

            <div class="metric">
              <span>Architecture</span>
              <strong>STABLE</strong>
            </div>

            <div class="metric">
              <span>Content Scaling</span>
              <strong>READY</strong>
            </div>

            <div class="metric">
              <span>Hosting</span>
              <strong>LIVE</strong>
            </div>
          </div>
        </div>
      </section>

      <section>
        <h2 class="section-title">My Vision Behind PureMDX</h2>
        <p class="section-subtitle">
          I did not want to create another simple blog website. My goal was to build a structured medical intelligence platform capable of scaling into thousands of interconnected clinical, Ayurvedic, educational, diagnostic, and research-driven knowledge nodes.
        </p>

        <div class="grid">
          <div class="card">
            <h3>Medical Intelligence</h3>
            <ul>
              <li>Clinical frameworks</li>
              <li>Ayurvedic disease architecture</li>
              <li>Diagnostics interpretation</li>
              <li>Evidence-based research integration</li>
              <li>Cross-reference mapping</li>
            </ul>
          </div>

          <div class="card">
            <h3>Enterprise Content Pipeline</h3>
            <ul>
              <li>Raw HTML ingestion</li>
              <li>SEO normalization</li>
              <li>Taxonomy-based publishing</li>
              <li>Incremental deterministic builds</li>
              <li>Automated deployment orchestration</li>
            </ul>
          </div>

          <div class="card">
            <h3>Scalable Architecture</h3>
            <ul>
              <li>Static high-speed delivery</li>
              <li>Firebase Hosting</li>
              <li>PWA offline support</li>
              <li>Semantic clustering</li>
              <li>Knowledge graph generation</li>
            </ul>
          </div>
        </div>
      </section>

      <section>
        <h2 class="section-title">Complete Development Roadmap</h2>
        <p class="section-subtitle">
          This project evolved through structured engineering phases focused on reliability, automation, scalability, visual refinement, semantic intelligence, and deployment integrity.
        </p>

        <div class="timeline">

          <div class="timeline-item">
            <h3>Phase 1 — Core Static Architecture</h3>
            <p>
              I established a deterministic static architecture using clean HTML, CSS, JavaScript, and Firebase Hosting. The focus was reliability, SEO stability, ultra-fast delivery, and zero-framework dependency.
            </p>
          </div>

          <div class="timeline-item">
            <h3>Phase 2 — Taxonomy Intelligence Layer</h3>
            <p>
              I designed a deep hierarchical structure containing supercategories, categories, subcategories, branches, and article nodes to support large-scale medical information growth.
            </p>
          </div>

          <div class="timeline-item">
            <h3>Phase 3 — AI-Assisted Ingestion Pipeline</h3>
            <p>
              I created structured ingestion systems capable of converting raw HTML, markdown, notes, and research text into standardized SEO-ready JSON content nodes.
            </p>
          </div>

          <div class="timeline-item">
            <h3>Phase 4 — Semantic & Graph Intelligence</h3>
            <p>
              I implemented semantic clustering, relationship mapping, medical cross-references, automated related-topic generation, and graph visualization exports.
            </p>
          </div>

          <div class="timeline-item">
            <h3>Phase 5 — UI Stabilization & Premium Branding</h3>
            <p>
              I refined the interface into a premium medical-tech visual system using a controlled enterprise-grade design language with strong typography, responsive layouts, structured spacing, and nested navigation.
            </p>
          </div>

          <div class="timeline-item">
            <h3>Phase 6 — Production Deployment Infrastructure</h3>
            <p>
              I built a hardened deployment orchestrator with validation, broken-link scanning, sitemap generation, manifest generation, snapshots, rollback readiness, and Firebase deployment automation.
            </p>
          </div>

        </div>
      </section>

      <section>
        <h2 class="section-title">Architecture Blueprint</h2>
        <p class="section-subtitle">
          The entire ecosystem was designed as a scalable publishing engine rather than a conventional website. Every subsystem has a defined operational role.
        </p>

        <div class="architecture">
          <h2 style="font-size:2.4rem;margin-bottom:12px">PureMDX System Layers</h2>
          <p style="color:rgba(248,250,252,0.75)">
            Structured, deterministic, modular, deployment-safe, and future-proof.
          </p>

          <div class="architecture-grid">

            <div class="architecture-card">
              <h4>Frontend Layer</h4>
              <p>
                Premium static UI, responsive layout system, knowledge graph interface, nested navigation, accessibility optimization, and PWA shell.
              </p>
            </div>

            <div class="architecture-card">
              <h4>Content Layer</h4>
              <p>
                Structured medical JSON corpus with taxonomy routing, SEO metadata, semantic keywords, and multilingual-ready content nodes.
              </p>
            </div>

            <div class="architecture-card">
              <h4>Intelligence Layer</h4>
              <p>
                Semantic clustering, related-topic engines, Sanskrit terminology indexing, medical citations, and graph relationship exports.
              </p>
            </div>

            <div class="architecture-card">
              <h4>Deployment Layer</h4>
              <p>
                Validation pipeline, broken-link scanners, incremental builds, deployment manifests, Firebase orchestration, rollback snapshots, and integrity enforcement.
              </p>
            </div>

          </div>

          <div class="folder-tree">
D:\PURE_MDX
│
├── <span class="highlight">project_core</span>
│   ├── site
│   │   ├── assets
│   │   │   ├── css
│   │   │   ├── js
│   │   │   └── images
│   │   ├── pages
│   │   └── data
│
├── <span class="highlight">templates</span>
│   ├── index-template.html
│   └── page-template.html
│
├── <span class="highlight">scripts</span>
│   ├── build
│   ├── deploy
│   ├── generators
│   ├── intelligence
│   ├── ingestion
│   └── validators
│
├── <span class="highlight">generated</span>
│   ├── intelligence
│   ├── reports
│   └── html
│
├── <span class="highlight">input</span>
│   └── raw_html
│
└── <span class="highlight">firebase</span>
    ├── firebase.json
    └── deployment config
          </div>
        </div>
      </section>

      <section>
        <h2 class="section-title">Content Ingestion Workflow</h2>
        <p class="section-subtitle">
          The system is now optimized for scale. I can simply drop raw HTML content into the ingestion folder and process it into structured production-ready medical pages.
        </p>

        <div class="grid">

          <div class="card">
            <h3>Step 1 — Raw Content Intake</h3>
            <p>
              Any HTML file, article, clinical guide, research summary, Ayurvedic notes, or structured educational document is placed into:
              <br><br>
              <strong>D:\PURE_MDX\input\raw_html</strong>
            </p>
          </div>

          <div class="card">
            <h3>Step 2 — AI Normalization</h3>
            <p>
              AI-assisted processing converts unstructured documents into taxonomy-aware, SEO-enriched, semantically tagged medical nodes.
            </p>
          </div>

          <div class="card">
            <h3>Step 3 — Deployment Automation</h3>
            <p>
              Incremental builds regenerate only affected pages, validate integrity, scan links/assets, and deploy automatically to Firebase Hosting.
            </p>
          </div>

        </div>
      </section>

      <section>
        <h2 class="section-title">Key Achievements</h2>

        <div class="grid">

          <div class="card">
            <h3>Production Deployment</h3>
            <p>
              Fully deployed Firebase Hosting environment with clean URLs, cache optimization, SSL integration, and deterministic build safety.
            </p>
          </div>

          <div class="card">
            <h3>Knowledge Graph Engine</h3>
            <p>
              Dynamic relationship visualization architecture connecting diseases, therapies, herbs, diagnostics, and educational concepts.
            </p>
          </div>

          <div class="card">
            <h3>Offline PWA Mode</h3>
            <p>
              Service worker architecture enabling installable offline-ready access for medical knowledge consumption.
            </p>
          </div>

          <div class="card">
            <h3>Multilingual Publishing</h3>
            <p>
              Parallel language-ready architecture for future Hindi, Sanskrit, and multilingual medical publishing.
            </p>
          </div>

          <div class="card">
            <h3>Medical SEO Infrastructure</h3>
            <p>
              Canonical URLs, JSON-LD schema, sitemap generation, metadata enforcement, semantic enrichment, and accessibility-focused rendering.
            </p>
          </div>

          <div class="card">
            <h3>Enterprise Stability</h3>
            <p>
              Validation pipelines, deployment orchestration, rollback readiness, integrity scanning, and deterministic generation logic.
            </p>
          </div>

        </div>
      </section>

      <section class="cta">
        <h2>The Vision Is Much Bigger Than A Website</h2>
        <p>
          PureMDX is evolving into a structured medical intelligence ecosystem combining Ayurveda, diagnostics, clinical medicine, education, semantic AI systems, healthcare research, and scalable knowledge engineering. The architecture is now stabilized, production-ready, and optimized for aggressive long-term scaling.
        </p>
      </section>

      <footer class="page-footer">
        <img src="/assets/images/brand/puremdx-logo.png" alt="PureMDX Logo" style="width:70px;height:70px;border-radius:18px;margin-bottom:16px;background:white;padding:5px;">
        <div style="font-size:1.4rem;font-weight:700;margin-bottom:10px">PureMDX</div>
        <div>
          Designed & Architected by Dr. Sandeep Shrivastva
        </div>
        <div style="margin-top:12px;color:rgba(248,250,252,0.5)">
          Premium Medical Knowledge Infrastructure • Firebase Hosted • AI-Assisted • Deterministic Architecture
        </div>
      </footer>
    </div>
  </RichContentShell>
</Layout>

<style>
  .puremdx-content {
    --bg: #FAF9F6;
    --card: #F1F5F9;
    --text: #1E293B;
    --dark: #0B132B;
    --light: #F8FAFC;
    --gold: #D4AF37;
    --cyan: #00E5FF;
    --border: rgba(30,41,59,0.12);
    --shadow: 0 10px 30px rgba(11,19,43,0.08);
    
    font-family: Inter, Segoe UI, sans-serif;
    color: var(--text);
  }

  .hero {
    background: linear-gradient(135deg, #081022 0%, #0B132B 55%, #13203d 100%);
    color: var(--light);
    padding: 60px 5%;
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    margin-bottom: 40px;
  }

  .hero::before {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: rgba(0,229,255,0.08);
    top: -120px;
    right: -120px;
    filter: blur(10px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: 40px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
  }

  .brand img {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    object-fit: cover;
    background: white;
    padding: 4px;
  }

  .puremdx-content h1 {
    font-size: 3rem;
    line-height: 1.1;
    margin-bottom: 20px;
    letter-spacing: -1.5px;
    color: inherit;
  }

  .accent {
    color: var(--gold);
  }

  .hero p {
    font-size: 1.1rem;
    color: rgba(248,250,252,0.85);
    max-width: 760px;
    margin-bottom: 24px;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .tag {
    border: 1px solid rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.05);
    color: var(--light);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.85rem;
  }

  .hero-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(12px);
    border-radius: 24px;
    padding: 28px;
    box-shadow: var(--shadow);
  }

  .hero-card h3 {
    font-size: 1.4rem;
    margin-bottom: 16px;
    color: var(--light);
  }

  .metric {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    font-size: 0.9rem;
  }

  .metric:last-child {
    border-bottom: none;
  }

  .metric strong {
    color: var(--cyan);
    font-size: 1rem;
  }

  section {
    padding: 40px 0;
  }

  .section-title {
    font-size: 2.2rem;
    color: var(--dark);
    margin-bottom: 14px;
    letter-spacing: -0.5px;
  }

  .section-subtitle {
    max-width: 920px;
    color: rgba(30,41,59,0.82);
    margin-bottom: 32px;
    font-size: 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 24px;
    box-shadow: var(--shadow);
    transition: 0.3s ease;
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .card h3 {
    margin-bottom: 12px;
    color: var(--dark);
    font-size: 1.25rem;
  }

  .card ul {
    padding-left: 18px;
    margin: 0;
  }

  .card li {
    margin-bottom: 8px;
  }

  .timeline {
    border-left: 4px solid var(--gold);
    margin-top: 20px;
    padding-left: 28px;
    display: grid;
    gap: 32px;
  }

  .timeline-item {
    position: relative;
  }

  .timeline-item::before {
    content: "";
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--cyan);
    position: absolute;
    left: -37px;
    top: 6px;
    border: 3px solid var(--dark);
  }

  .timeline-item h3 {
    color: var(--dark);
    margin-bottom: 8px;
    font-size: 1.3rem;
  }

  .architecture {
    background: #08101d;
    color: #f8fafc;
    border-radius: 28px;
    padding: 40px 30px;
    margin-top: 20px;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .architecture-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 32px;
  }

  .architecture-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(0, 229, 255, 0.2);
    border-radius: 20px;
    padding: 28px;
    transition: all 0.3s ease;
  }

  .architecture-card:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--cyan);
    transform: translateY(-2px);
  }

  .architecture-card h4 {
    color: var(--cyan);
    margin-bottom: 14px;
    font-size: 1.3rem;
    font-weight: 700;
  }

  .architecture-card p {
    color: rgba(248, 250, 252, 0.9);
    line-height: 1.6;
    margin: 0;
    font-size: 0.95rem;
  }

  .folder-tree {
    background: #08101d;
    color: #d9f3ff;
    border-radius: 20px;
    padding: 24px;
    overflow-x: auto;
    font-family: Consolas, monospace;
    line-height: 1.8;
    margin-top: 28px;
    border: 1px solid rgba(255,255,255,0.08);
    font-size: 0.9rem;
  }

  .highlight {
    color: var(--gold);
  }

  .cta {
    background: linear-gradient(135deg, #0B132B 0%, #13203d 100%);
    color: var(--light);
    border-radius: 28px;
    padding: 40px;
    text-align: center;
    margin: 40px 0;
  }

  .cta h2 {
    font-size: 2.2rem;
    margin-bottom: 16px;
    color: var(--light);
  }

  .cta p {
    max-width: 850px;
    margin: auto;
    color: rgba(248,250,252,0.82);
  }

  .page-footer {
    background: #08101d;
    color: rgba(248,250,252,0.78);
    padding: 32px;
    border-radius: 24px;
    text-align: center;
    margin-top: 40px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .puremdx-content h1 {
      font-size: 2.2rem;
    }

    .section-title {
      font-size: 1.8rem;
    }

    .cta {
      padding: 30px 20px;
    }

    .cta h2 {
      font-size: 1.6rem;
    }
  }
</style>

