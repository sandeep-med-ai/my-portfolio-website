---
import '../styles/custom.css';

interface Props {
	title?: string;
    description?: string;
}

const { 
    title = "Dr. Sandeep | AI Automation & Clinical Expert", 
    description = "Healthcare AI, Ayurveda, automation, and clinical intelligence portfolio by Dr. Sandeep Shrivastva." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <meta name="description" content={description} />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=JetBrains+Mono&display=swap" rel="stylesheet">
	</head>
	<body>
        <header class="md-header">
            <div class="md-header__inner md-grid">
                <a href="/" title="Dr. Sandeep" class="md-logo" style="text-decoration: none; color: white; font-weight: 800; font-size: 1.2rem; margin-right: 2rem;">
                    Dr. Sandeep
                </a>
            </div>
        </header>
        <nav class="md-tabs">
            <div class="md-tabs__inner md-grid">
                <ul class="md-tabs__list">
                    <li class="md-tabs__item"><a href="/" class="md-tabs__link">Home</a></li>
                    
                    <li class="md-tabs__item dropdown">
                        <span class="md-tabs__link">Clinical</span>
                        <ul class="dropdown-menu">
                            <li><a href="/clinical/">Clinical Intelligence</a></li>
                            <li><a href="/clinical/practice/Case-Sheet/">Medical Notes</a></li>
                            <li><a href="/clinical/research/case-studies/">Case Studies</a></li>
                            <li><a href="/clinical/research/treatment-logic/">Treatment Logic</a></li>
                            <li><a href="/clinical/surveys/differential-diagnosis/">Differential Diagnosis</a></li>
                        </ul>
                    </li>

                    <li class="md-tabs__item dropdown">
                        <span class="md-tabs__link">AI Systems</span>
                        <ul class="dropdown-menu">
                            <li><a href="/ai-systems/hub/">AI Hub</a></li>
                            <li><a href="/ai-systems/lab/">AI Lab</a></li>
                            <li><a href="/ai-systems/projects/">AI Projects</a></li>
                            <li><a href="/ai-systems/projects/modern-opd-ai-system/">Modern OPD AI</a></li>
                        </ul>
                    </li>

                    <li class="md-tabs__item dropdown">
                        <span class="md-tabs__link">Research & Data</span>
                        <ul class="dropdown-menu">
                            <li><a href="/research/insights/">Insights</a></li>
                            <li><a href="/research/insights/the-clinical-reality/">Clinical Reality</a></li>
                            <li><a href="/research/analysis/">Data Analysis</a></li>
                            <li><a href="/research/surveys/">Surveys</a></li>
                            <li><a href="/research/reports/">Research Reports</a></li>
                        </ul>
                    </li>

                    <li class="md-tabs__item dropdown">
                        <span class="md-tabs__link">Knowledge Base</span>
                        <ul class="dropdown-menu">
                            <li><a href="/knowledge/healthtech/">HealthTech Studies</a></li>
                            <li><a href="/knowledge/visuals/">Visual Library</a></li>
                        </ul>
                    </li>

                    <li class="md-tabs__item"><a href="/portfolio/" class="md-tabs__link">Portfolio</a></li>
                    <li class="md-tabs__item"><a href="/contact/" class="md-tabs__link">Contact</a></li>
                </ul>
            </div>
        </nav>
        <main class="md-main">
            <div class="md-main__inner md-grid">
                <div class="md-content">
                    <article class="md-content__inner md-typeset">
                        <slot />
                    </article>
                </div>
            </div>
        </main>
        <footer style="margin-top: 4rem; padding: 2rem 0; border-top: 1px solid var(--portfolio-line); text-align: center; color: var(--portfolio-muted);">
            <div class="md-grid">
                <p>&copy; {new Date().getFullYear()} Dr. Sandeep Shrivastva. Built with Astro.</p>
                <p style="font-size: 0.75rem; margin-top: 0.5rem;"><a href="/logs/" style="color: inherit; text-decoration: none; opacity: 0.6;">Build Logs</a></p>
            </div>
        </footer>
	</body>
</html>

<style is:global>
    :root {
        --md-primary-fg-color: #102a43;
    }
    body {
        margin: 0;
        font-family: 'Inter', sans-serif;
    }
    .md-header {
        background: var(--md-primary-fg-color);
        color: white;
        padding: 0.5rem 0;
    }
    .md-tabs {
        background: #102a43;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        position: relative;
        z-index: 100;
    }
    .md-grid {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1rem;
    }
    .md-tabs__list {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
        gap: 1.5rem;
    }
    .md-tabs__item {
        position: relative;
        padding: 0.75rem 0;
    }
    .md-tabs__link {
        color: white;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    .dropdown:hover .dropdown-menu {
        display: block;
    }
    .dropdown-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background: #102a43;
        list-style: none;
        padding: 0.5rem 0;
        margin: 0;
        min-width: 200px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 4px;
        box-shadow: 0 8px 16px rgba(0,0,0,0.2);
    }
    .dropdown-menu li a {
        display: block;
        padding: 0.6rem 1.2rem;
        color: white;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 500;
    }
    .dropdown-menu li a:hover {
        background: rgba(255,255,255,0.1);
    }
    .dropdown .md-tabs__link::after {
        content: '▼';
        font-size: 0.6rem;
        opacity: 0.7;
    }
</style>
